# Used by the local Agent process; never sent to Agents API callers.
CREATIVE_REASONING_API_KEY=
# Optional executable override for a locally built CLI.
# GEA_CLI_BIN=/absolute/path/to/gea

# HTTP caller configuration. Local mode does not require a token.
GEA_AGENTS_API_URL=http://127.0.0.1:8795/api/v1
GEA_ENVIRONMENT=local
# GEA_AGENT_ID=UUID-from-GET-agents
# Cloud Preview: use https://musegea.com/api/v1, environment preview,
# and a user OAuth access token issued to your GEA application.
# GEA_ACCESS_TOKEN=
