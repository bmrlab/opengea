{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent.ts",
    "agents/**/*.ts",
    "context/**/*.ts",
    "runtime.d.ts",
    "bindings.d.ts"
  ]
}
