# Local model access. Hosted execution uses the Studio model configuration.
CREATIVE_REASONING_API_KEY=

# A Feishu enterprise custom app with bot capability and WebSocket events.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Allow all verified senders, or use a JSON array of {tenantKey, openId} entries.
FEISHU_ALLOWED_SENDERS=*

# Optional: use an existing private environment file for local credentials.
# GEA_ENV_FILE=/absolute/path/to/private.env

# Until the matching CLI is published, use a locally built native executable.
# GEA_CLI_BIN=/absolute/path/to/gea
# GEA_WORKER_RUNTIME_BINARY=/absolute/path/to/gea-worker-runtime
# WORKER_RUNTIME_SYSTEM_WORKER_ROOT=/absolute/path/to/system-workers
