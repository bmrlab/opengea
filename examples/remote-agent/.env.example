# Public Agents API serving the caller, including /api/v1.
GEA_AGENTS_API_URL=https://musegea.com/api/v1
GEA_ENVIRONMENT=production
# Public Agent ID returned after deploying THIS caller Worker.
GEA_AGENT_ID=
GEA_REMOTE_AGENT_ID=01a0a903-48d6-7764-bd9d-6260bb2117c2
# Fresh USER OAuth access token, scoped to the consuming tenant. Never a Project Key.
# Only this Node verifier uses it; never place it in the Worker source or commit it.
GEA_ACCESS_TOKEN=
