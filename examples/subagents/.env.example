# Hosted Agents API root; the verifier explicitly selects Preview.
GEA_AGENTS_API_URL=https://musegea.com/api/v1
# Stable public coordinator ID; omit only when its name is unique.
GEA_AGENT_ID=
# Project key grants coordinator AND reviewer chats:read/chats:write/runs:write.
GEA_PROJECT_API_KEY=
# Must match agent-dev.json apiPort.
GEA_LOCAL_AGENTS_API_URL=http://127.0.0.1:8794/api/v1

# Session/Run-capable CLI release is pending; use a compatible local executable.
# GEA_CLI_BIN=/absolute/path/to/gea
# GEA_WORKER_RUNTIME_BINARY=/absolute/path/to/gea-worker-runtime
# WORKER_RUNTIME_SYSTEM_WORKER_ROOT=/absolute/path/to/system-workers
# GEA_ENV_FILE=/absolute/path/to/private.env
