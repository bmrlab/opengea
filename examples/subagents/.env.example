# Hosted verification: copy the coordinator's Preview Agent URL, WITHOUT /run.
GEA_AGENT_URL=
# Preview key: runs:write, chats:write (new chats), and chats:read. Keep it private.
GEA_PROJECT_API_KEY=
# Optional override for pnpm verify:local (no Project key is sent locally).
# GEA_LOCAL_AGENT_URL=http://127.0.0.1:8793/gea/agents/coordinator

# Until the subagent-capable CLI is published, supply a compatible executable.
# GEA_CLI_BIN=/absolute/path/to/gea
# GEA_WORKER_RUNTIME_BINARY=/absolute/path/to/gea-worker-runtime
# WORKER_RUNTIME_SYSTEM_WORKER_ROOT=/absolute/path/to/system-workers
# GEA_ENV_FILE=/absolute/path/to/private.env
