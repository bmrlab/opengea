{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "agent.ts",
    "agents/**/*.ts",
    "subagents/**/*.ts",
    "tools/**/*.ts",
    "shared/**/*.ts",
    ".gea/bindings.d.ts"
  ]
}
