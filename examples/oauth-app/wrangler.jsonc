{
  "name": "opengea-oauth-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_FLOWS",
        "class_name": "LoginFlow",
      },
      {
        "name": "OAUTH_SESSIONS",
        "class_name": "OAuthSession",
      },
      {
        "name": "CONVERSATION_RUNS",
        "class_name": "ConversationRuns",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoginFlow", "OAuthSession", "ConversationRuns"],
    },
  ],
}
