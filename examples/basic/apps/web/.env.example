# Server-only configuration; no NEXT_PUBLIC variables.
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
GEA_MODE=local
GEA_AGENTS_API_URL=http://127.0.0.1:8788/api/v1
# Hosted mode requires the stable Agent ID from gea agent push.
GEA_AGENT_ID=
GEA_ENVIRONMENT=preview
# Hosted mode only. Use the public /api/v1 root above.
# The Project key needs runs:write, chats:write and chats:read.
GEA_PROJECT_API_KEY=
